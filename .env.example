# Copy to .env and fill in. .env is gitignored. NEVER commit real keys.
# Use fresh testnet-only wallets. Never put a wallet that holds real funds here.

# --- RPC ---
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# --- Deployer: deploys contracts, creates markets, seeds Uniswap liquidity ---
# Needs Sepolia ETH (~0.5) + USDC (for pool liquidity)
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# --- Relayer: submits users' proofs and pays gas ---
# Needs Sepolia ETH (~0.3)
RELAYER_ADDRESS=
RELAYER_PRIVATE_KEY=

# --- CRE: sends resolution reports (cre workflow simulate --broadcast) ---
# Needs Sepolia ETH (~0.1). Can be the same key as the deployer.
CRE_ETH_PRIVATE_KEY=

# --- Test users for the end-to-end script (Priya, Rahul, Arjun) ---
# Each needs a little Sepolia ETH (deposits are public txs) + USDC
USER1_ADDRESS=
USER1_PRIVATE_KEY=
USER2_ADDRESS=
USER2_PRIVATE_KEY=
USER3_ADDRESS=
USER3_PRIVATE_KEY=

# --- Data sources ---
# ESPN scoreboard (football) and Jolpica (F1) need no key.
# Optional backups:
FOOTBALL_DATA_API_KEY=
