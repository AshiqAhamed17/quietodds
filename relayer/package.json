{
  "name": "@quietodds/relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Submits QuietOdds proofs so users' wallets never touch their private bets.",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:vercel": "node scripts/build-vercel.mjs",
    "deploy": "node scripts/build-vercel.mjs && vercel deploy --prebuilt --prod"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@quietodds/lib": "0.1.0",
    "hono": "^4.13.16",
    "tsx": "^4.23.15",
    "viem": "^2.40.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
